  <section id="experience" class="">
    <h2>
      <span class="noprint">{{ texts.work_experience }}</span><span class="print">{{ texts.selected_experience }}</span>
      <a href="javascript: void" onclick="this.parentElement.parentElement.classList.toggle('expanded')" class="see-more-btn"></a>
    </h2>
    <div class="c2-container">
      {% for position in experience %}
      <div class="section-item {{'' if (position.groups and position.groups.includes('main')) else 'if-not-collapsed'}}">
        <div class="title">
          <span class="first-part">
            {{position.company}}
          </span>
          <span class="date-range">
            {{position.start | format_date(texts.months)}} &mdash; {{(position.end | format_date(texts.months)) if position.end else "Present"}}
          </span>
        </div>
        <span class="subtitle">
          {{position.job_title }} 
        </span>
        {% if position.description_bullets %}
        <ul class="simple-list if-not-collapsed">
          {% for x in position.description_bullets %}
          <li>{{ x | format_html | safe }}</li>
          {% endfor %}
          {% if (position.technologies and (position.technologies.lenght > 0)) %}
          <li>{{position.technologies | join(", ") | format_html | safe}}</li>
          {% endif %}
        </ul>
        {% endif %}
        <div class="if-collapsed">
          {{ position.short_description | format_html | safe }}
        </div>
      </div>
      {% endfor %}
    </div>
  </section>
</div>

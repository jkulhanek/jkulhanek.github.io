  <section id="projects" class="c2">
    <h2>{{ texts["Other projects"] }}</h2>
    <div class="c2-container">
      {% for item in projects %}
      {% set project_image = ("images/project-" + (item.image | urlencode )) %}
      <div class="section-item image-item-container">
        <div class="responsive-image-container">
          <div class="responsive-image">
            <picture>
              <source srcset="{{ (project_image + ".webp") | safe }}, {{ (project_image + "@2x.webp") | safe }} 2x" type="image/webp" />
              <source srcset="{{ (project_image + ".jpg") | safe }}, {{ (project_image + "@2x.jpg") | safe }} 2x" type="image/jpeg" />
              <img alt="{{item.name}}"
                class="lazy-img"
                loading="lazy"
                src="{{ (project_image + ".jpg") | safe }}" />
            </picture>
          </div>
        </div>
        <div class="text">
          <span class="title">{{item.name}}</span>
          {% if item.url %}
          <span class="subtitle"><a href="{{item.url | safe }}">{{item.url | safe }}</a></span>
          {% endif %}
          {{ (item.long_description if is_detail else item.description) | format_html | safe }}
          {% if item.categories %}<br /><i>
            {{item.categories | join(', ') | format_html | safe }}
          </i>{% endif %}
        </div>
      </div>
      {% endfor %}
    </div>
  </section>
